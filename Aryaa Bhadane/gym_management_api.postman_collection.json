    {
      "name": "3. Membership Management",
      "item": [
        {
          "name": "Renew / Extend Membership",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalMonths\": 6,\n  \"tier\": \"Platinum\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/{{memberId}}/renew",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{memberId}}", "renew"]
            },
            "description": "Extends membership expiry date from max(today, currentExpiry) by additionalMonths."
          },
          "response": []
        },
        {
          "name": "Get Expired Memberships",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members/expired",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "expired"]
            },
            "description": "Fetches all members whose membershipExpiryDate < current date or status is expired."
          },
          "response": []
